#!/usr/bin/env bash

# remove ~/.gml if plaster failed to get new dictionary.
# rm -rf ~/.gml

VENV=venv_plaster
# needs python >= 3.8
virtualenv $VENV -p python3.8
source $VENV/bin/activate

python3 -m pip install \
    --index-url https://nexus.osdc.io/repository/pypi-all/simple \
    "plaster>=1.0.7,<1.1" \
    "psqlgml>=0.2.4" \
    pre-commit \
    isort \
    black
plaster --version
psqlgml --version
plaster generate -p gdcdictionary -o src/gdcdatamodel2/models -s src/gdcdatamodel2/partial_dictionary
isort src
black src
pre-commit run -a

rm -rf $VENV
